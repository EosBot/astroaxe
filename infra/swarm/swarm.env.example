# Copie para um arquivo fora do repositório ou exporte por CI. Não inclua credenciais aqui.
ASTROAXE_STACK_NAME=astroaxe
ASTROAXE_HOST=app.seu-dominio.example
SITE_URL=https://app.seu-dominio.example
NOMINATIM_USER_AGENT=AstroAxe/6.0 (contato@seu-dominio.example)
LOG_LEVEL=info
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-brevo-smtp-login
EMAIL_FROM=nao-responda@seu-dominio.example
EMAIL_FROM_NAME=AstroAxe

# Todas as imagens devem usar digest sha256 obtido do registry após build/scan.
ASTROAXE_APP_IMAGE=registry.example/astroaxe/app@sha256:replace
ASTROAXE_WORKER_IMAGE=registry.example/astroaxe/worker@sha256:replace
ASTROAXE_MIGRATE_IMAGE=registry.example/astroaxe/migrate@sha256:replace
TRAEFIK_IMAGE=traefik@sha256:replace
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:replace
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy@sha256:replace

APP_REPLICAS=2
TRAEFIK_REPLICAS=2
CLOUDFLARED_REPLICAS=2

# Nomes versionados; o conteúdo é criado fora deste arquivo com `docker secret create`.
DATABASE_URL_SECRET=astroaxe_database_url_v1
REDIS_URL_SECRET=astroaxe_redis_url_v1
GUEST_SESSION_SECRET_NAME=astroaxe_guest_session_v1
AUTH_SESSION_SECRET_NAME=astroaxe_auth_session_v1
FINGERPRINT_SECRET_NAME=astroaxe_fingerprint_v1
CLOUDFLARE_TUNNEL_SECRET=astroaxe_cloudflare_tunnel_v1
SMTP_PASSWORD_SECRET=astroaxe_smtp_password_v1
