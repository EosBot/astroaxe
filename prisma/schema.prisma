generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GuestSession {
  id        String         @id @default(uuid()) @db.Uuid
  tokenHash String         @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  profiles  BirthProfile[]

  @@index([expiresAt])
  @@map("guest_sessions")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  sessions            AccountSession[]
  profiles            BirthProfile[]
  culturalContributor CulturalContributor?
  emailOutbox         EmailOutbox[]
  accountTokens       AccountToken[]
  ceremonialPlans     CeremonialPlan[]

  @@map("users")
}

model EmailOutbox {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  accountTokenId    String?       @map("account_token_id") @db.Uuid
  kind              String        @db.VarChar(50)
  templateVersion   String        @map("template_version") @db.VarChar(30)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(160)
  status            String        @default("PENDING") @db.VarChar(20)
  attemptCount      Int           @default(0) @map("attempt_count")
  nextAttemptAt     DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner        String?       @map("lease_owner") @db.Uuid
  leaseExpiresAt    DateTime?     @map("lease_expires_at") @db.Timestamptz(6)
  providerMessageId String?       @map("provider_message_id") @db.VarChar(255)
  lastErrorCategory String?       @map("last_error_category") @db.VarChar(50)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?     @map("sent_at") @db.Timestamptz(6)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountToken      AccountToken? @relation(fields: [accountTokenId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([createdAt])
  @@index([accountTokenId])
  @@map("email_outbox")
}

model AccountToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  purpose   String        @db.VarChar(30)
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails    EmailOutbox[]

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("account_tokens")
}

model AccountSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("account_sessions")
}

model BirthProfile {
  id             String         @id @default(uuid()) @db.Uuid
  guestSessionId String?        @map("guest_session_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  displayName    String         @map("display_name") @db.VarChar(100)
  birthDate      DateTime       @map("birth_date") @db.Date
  birthTime      String?        @map("birth_time") @db.VarChar(5)
  timePrecision  TimePrecision  @map("time_precision")
  latitude       Decimal        @db.Decimal(9, 6)
  longitude      Decimal        @db.Decimal(9, 6)
  timezone       String         @db.VarChar(100)
  location       String         @db.VarChar(200)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  guestSession   GuestSession?  @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chart          NatalChart?
  journalEntries JournalEntry[]
  regencyFeedbacks RegencyFeedback[]
  ceremonialPlans  CeremonialPlan[]

  @@index([guestSessionId, createdAt])
  @@index([userId, createdAt])
  @@map("birth_profiles")
}

model RegencyFeedback {
  id                   String       @id @default(uuid()) @db.Uuid
  birthProfileId       String       @map("birth_profile_id") @db.Uuid
  methodVersion        String       @map("method_version") @db.VarChar(100)
  matrixVersion        String       @map("matrix_version") @db.VarChar(100)
  configVersion        String       @map("config_version") @db.VarChar(100)
  scorerVersion        String       @map("scorer_version") @db.VarChar(100)
  questionnaireVersion String       @map("questionnaire_version") @db.VarChar(100)
  questionnaireAnswers Json         @map("questionnaire_answers")
  predictedTriad       Json         @map("predicted_triad")
  verdict              String       @db.VarChar(30)
  knowsOrisas          Boolean      @map("knows_orisas")
  correctedTriad       Json?        @map("corrected_triad")
  confirmationBasis    String       @map("confirmation_basis") @db.VarChar(40)
  comment              String?      @db.VarChar(1000)
  consentVersion       String       @map("consent_version") @db.VarChar(50)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  birthProfile         BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@unique([birthProfileId, methodVersion, questionnaireVersion])
  @@index([methodVersion, verdict])
  @@map("regency_feedback")
}

model RegencyBenchmarkRelease {
  id             String   @id @default(uuid()) @db.Uuid
  releaseVersion String   @unique @map("release_version") @db.VarChar(100)
  cohortSize     Int      @map("cohort_size")
  cellCounts     Json     @map("cell_counts")
  generatedAt    DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  @@map("regency_benchmark_releases")
}

model JournalEntry {
  id             String                 @id @default(uuid()) @db.Uuid
  birthProfileId String                 @map("birth_profile_id") @db.Uuid
  entryDate      DateTime               @map("entry_date") @db.Date
  content        String                 @db.VarChar(4000)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  birthProfile   BirthProfile           @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  revisions      JournalEntryRevision[]

  @@unique([birthProfileId, entryDate])
  @@index([birthProfileId, entryDate(sort: Desc)])
  @@map("journal_entries")
}

model JournalEntryRevision {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  content        String       @db.VarChar(4000)
  supersededAt   DateTime     @default(now()) @map("superseded_at") @db.Timestamptz(6)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId, supersededAt(sort: Desc)])
  @@map("journal_entry_revisions")
}

model NatalChart {
  id               String               @id @default(uuid()) @db.Uuid
  birthProfileId   String               @unique @map("birth_profile_id") @db.Uuid
  inputFingerprint String               @map("input_fingerprint") @db.Char(64)
  engineVersion    String               @map("engine_version") @db.VarChar(50)
  configVersion    String               @map("config_version") @db.VarChar(50)
  calculationMode  String               @map("calculation_mode") @db.VarChar(20)
  result           Json
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  birthProfile     BirthProfile         @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  revisions        NatalChartRevision[]

  @@index([inputFingerprint])
  @@map("natal_charts")
}

model NatalChartRevision {
  id               String     @id @default(uuid()) @db.Uuid
  natalChartId     String     @map("natal_chart_id") @db.Uuid
  inputFingerprint String     @map("input_fingerprint") @db.Char(64)
  engineVersion    String     @map("engine_version") @db.VarChar(50)
  configVersion    String     @map("config_version") @db.VarChar(50)
  calculationMode  String     @map("calculation_mode") @db.VarChar(20)
  result           Json
  reason           String     @db.VarChar(50)
  supersededAt     DateTime   @default(now()) @map("superseded_at") @db.Timestamptz(6)
  natalChart       NatalChart @relation(fields: [natalChartId], references: [id], onDelete: Cascade)

  @@index([natalChartId, supersededAt])
  @@map("natal_chart_revisions")
}

model CulturalContributor {
  id                   String                          @id @default(uuid()) @db.Uuid
  userId               String?                         @unique @map("user_id") @db.Uuid
  displayName          String                          @map("display_name") @db.VarChar(120)
  publicBio            String?                         @map("public_bio") @db.VarChar(1000)
  attributionLine      String                          @map("attribution_line") @db.VarChar(300)
  role                 String                          @db.VarChar(30)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  user                 User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  authoredEntries      CulturalEntry[]                 @relation("CulturalEntryAuthor")
  reviewedEntries      CulturalEntry[]                 @relation("CulturalEntryReviewer")
  reviews              CulturalReview[]
  transitTextsAuthored TransitInterpretationTemplate[] @relation("TransitTextAuthor")
  transitTextsReviewed TransitInterpretationTemplate[] @relation("TransitTextReviewer")
  ceremonialReviews    CeremonialReview[]

  @@map("cultural_contributors")
}

model TransitInterpretationTemplate {
  id               String               @id @default(uuid()) @db.Uuid
  transitingBody   String               @map("transiting_body") @db.VarChar(30)
  natalBody        String               @map("natal_body") @db.VarChar(30)
  aspectType       String               @map("aspect_type") @db.VarChar(30)
  locale           String               @default("pt-BR") @db.VarChar(10)
  title            String               @db.VarChar(180)
  opening          String               @db.VarChar(1200)
  deepening        String               @db.Text
  technicalWhy     String               @map("technical_why") @db.VarChar(1500)
  reflectionPrompt String               @map("reflection_prompt") @db.VarChar(500)
  practice         String               @db.VarChar(1000)
  version          String               @db.VarChar(80)
  status           String               @default("DRAFT") @db.VarChar(30)
  generationMethod String               @default("HUMAN") @map("generation_method") @db.VarChar(30)
  authorId         String               @map("author_id") @db.Uuid
  reviewerId       String?              @map("reviewer_id") @db.Uuid
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  author           CulturalContributor  @relation("TransitTextAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer         CulturalContributor? @relation("TransitTextReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([transitingBody, natalBody, aspectType, locale, version])
  @@index([transitingBody, natalBody, aspectType, locale, status])
  @@map("transit_interpretation_templates")
}

model CulturalSource {
  id           String          @id @default(uuid()) @db.Uuid
  sourceKey    String          @unique @map("source_key") @db.VarChar(120)
  title        String          @db.VarChar(300)
  url          String          @db.VarChar(2000)
  evidenceKind String          @map("evidence_kind") @db.VarChar(40)
  usageStatus  String          @default("REFERENCE_ONLY") @map("usage_status") @db.VarChar(30)
  licenseNote  String          @map("license_note") @db.VarChar(500)
  accessedAt   DateTime        @map("accessed_at") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  claims       CulturalClaim[]

  @@map("cultural_sources")
}

model CulturalEntry {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @db.VarChar(120)
  displayName   String               @map("display_name") @db.VarChar(120)
  category      String               @db.VarChar(40)
  traditionId   String               @map("tradition_id") @db.VarChar(120)
  summary       String               @db.VarChar(2000)
  editorialBody String               @map("editorial_body") @db.Text
  version       String               @db.VarChar(80)
  status        String               @default("DRAFT") @db.VarChar(30)
  authorId      String               @map("author_id") @db.Uuid
  reviewerId    String?              @map("reviewer_id") @db.Uuid
  reviewedAt    DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  author        CulturalContributor  @relation("CulturalEntryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer      CulturalContributor? @relation("CulturalEntryReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  claims        CulturalClaim[]
  reviews       CulturalReview[]

  @@unique([slug, version])
  @@index([slug, status, publishedAt])
  @@map("cultural_entries")
}

model CulturalClaim {
  id            String         @id @default(uuid()) @db.Uuid
  entryId       String         @map("entry_id") @db.Uuid
  sourceId      String         @map("source_id") @db.Uuid
  claimKey      String         @map("claim_key") @db.VarChar(120)
  predicate     String         @db.VarChar(120)
  objectSummary String         @map("object_summary") @db.VarChar(500)
  sourceLocator String?        @map("source_locator") @db.VarChar(120)
  status        String         @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  entry         CulturalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  source        CulturalSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([entryId, claimKey])
  @@index([sourceId])
  @@map("cultural_claims")
}

model CulturalReview {
  id         String              @id @default(uuid()) @db.Uuid
  entryId    String              @map("entry_id") @db.Uuid
  reviewerId String              @map("reviewer_id") @db.Uuid
  decision   String              @db.VarChar(30)
  note       String?             @db.VarChar(2000)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  entry      CulturalEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reviewer   CulturalContributor @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@map("cultural_reviews")
}

enum TimePrecision {
  KNOWN
  UNKNOWN
}

// ---------------------------------------------------------------------------
// Ceremonial laboratory — provenance-first corpus and private practice records.
//
// Identity rule: an entity belongs to exactly one CeremonialSourceSystem. Workspaces
// (ANGELICAL, ARS_GOETIA, ...) are product navigation only and reach systems solely
// through explicit membership rows, so a broad workspace can never merge two distinct
// systems that happen to share a name.
//
// Claim rule: every correspondence, variant, timing rule and cross-reference carries a
// mandatory locator, so nothing is assertable without a citable position in an edition.
// ---------------------------------------------------------------------------

model CeremonialSourceSystem {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(200)
  tradition   String   @db.VarChar(120)
  summary     String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspaceMemberships CeremonialWorkspaceMembership[]
  works                CeremonialWork[]
  entities             CeremonialEntity[]
  timingProfiles       CeremonialTimingProfile[]

  @@map("ceremonial_source_systems")
}

model CeremonialWorkspaceMembership {
  id             String                 @id @default(uuid()) @db.Uuid
  workspaceKind  String                 @map("workspace_kind") @db.VarChar(40)
  sourceSystemId String                 @map("source_system_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceSystem   CeremonialSourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: Cascade)

  @@unique([workspaceKind, sourceSystemId])
  @@index([workspaceKind])
  @@map("ceremonial_workspace_memberships")
}

model CeremonialWork {
  id             String                 @id @default(uuid()) @db.Uuid
  sourceSystemId String                 @map("source_system_id") @db.Uuid
  title          String                 @db.VarChar(300)
  authorLabel    String?                @map("author_label") @db.VarChar(200)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceSystem   CeremonialSourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: Restrict)
  editions       CeremonialEdition[]

  @@unique([sourceSystemId, title])
  @@map("ceremonial_works")
}

/// A specific witness: manuscript family, printing, translation or compilation.
/// Compilations and translations stay distinct editions, never collapsed into the work.
model CeremonialEdition {
  id          String  @id @default(uuid()) @db.Uuid
  workId      String  @map("work_id") @db.Uuid
  label       String  @db.VarChar(200)
  language    String  @db.VarChar(35)
  publishedAt Int?    @map("published_at")
  /// Provenance/rights facets. Import default is UNKNOWN + LOCAL_ONLY.
  rights      String  @default("UNKNOWN") @db.VarChar(30)
  access      String  @default("LOCAL_ONLY") @db.VarChar(20)
  sensitivity String  @default("CULTURALLY_SENSITIVE") @db.VarChar(30)
  /// Free-text jurisdiction/evidence note; never a substitute for a review row.
  rightsNote  String? @map("rights_note") @db.VarChar(1000)

  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  work            CeremonialWork             @relation(fields: [workId], references: [id], onDelete: Cascade)
  artifacts       CeremonialArtifact[]
  locators        CeremonialLocator[]
  entityVariants  CeremonialEntityVariant[]
  correspondences CeremonialCorrespondence[]
  timingProfiles  CeremonialTimingProfile[]

  @@unique([workId, label, language])
  @@index([access, rights])
  @@map("ceremonial_editions")
}

/// A concrete file in the private archive. Only a normalized relative path and a content
/// hash are stored; the absolute host location never reaches the database.
model CeremonialArtifact {
  id               String  @id @default(uuid()) @db.Uuid
  editionId        String  @map("edition_id") @db.Uuid
  relativePath     String  @map("relative_path") @db.VarChar(1024)
  contentHash      String  @unique @map("content_hash") @db.Char(64)
  byteSize         BigInt  @map("byte_size")
  mimeType         String  @map("mime_type") @db.VarChar(160)
  extractionState  String  @default("PENDING") @map("extraction_state") @db.VarChar(20)
  extractionReason String? @map("extraction_reason") @db.VarChar(300)
  pageCount        Int?    @map("page_count")
  rights           String  @default("UNKNOWN") @db.VarChar(30)
  access           String  @default("LOCAL_ONLY") @db.VarChar(20)
  sensitivity      String  @default("CULTURALLY_SENSITIVE") @db.VarChar(30)

  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  edition   CeremonialEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  locators  CeremonialLocator[]
  media     CeremonialMedia[]

  @@unique([editionId, relativePath])
  @@index([extractionState])
  @@map("ceremonial_artifacts")
}

/// A citable position. Every claim in this subsystem must point at one of these.
model CeremonialLocator {
  id         String  @id @default(uuid()) @db.Uuid
  editionId  String  @map("edition_id") @db.Uuid
  artifactId String? @map("artifact_id") @db.Uuid
  kind       String  @db.VarChar(30)
  reference  String  @db.VarChar(120)

  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  edition         CeremonialEdition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  artifact        CeremonialArtifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  entityVariants  CeremonialEntityVariant[]
  media           CeremonialMedia[]
  correspondences CeremonialCorrespondence[]
  crossReferences CeremonialCrossReference[]
  timingProfiles  CeremonialTimingProfile[]
  reviews         CeremonialReview[]

  @@unique([editionId, kind, reference])
  @@map("ceremonial_locators")
}

model CeremonialEntity {
  id             String                 @id @default(uuid()) @db.Uuid
  sourceSystemId String                 @map("source_system_id") @db.Uuid
  entityKind     String                 @map("entity_kind") @db.VarChar(40)
  canonicalName  String                 @map("canonical_name") @db.VarChar(200)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceSystem   CeremonialSourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: Restrict)

  variants        CeremonialEntityVariant[]
  media           CeremonialMedia[]
  correspondences CeremonialCorrespondence[]
  outgoingRefs    CeremonialCrossReference[] @relation("CeremonialCrossReferenceFrom")
  incomingRefs    CeremonialCrossReference[] @relation("CeremonialCrossReferenceTo")

  @@unique([sourceSystemId, canonicalName])
  @@index([entityKind])
  @@map("ceremonial_entities")
}

/// How one edition renders an entity. Divergent ranks/offices coexist instead of being
/// reconciled into a single "correct" record.
model CeremonialEntityVariant {
  id          String  @id @default(uuid()) @db.Uuid
  entityId    String  @map("entity_id") @db.Uuid
  editionId   String  @map("edition_id") @db.Uuid
  locatorId   String  @map("locator_id") @db.Uuid
  variantName String? @map("variant_name") @db.VarChar(200)
  rank        String? @db.VarChar(120)
  office      String? @db.VarChar(1000)

  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  entity    CeremonialEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  edition   CeremonialEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  locator   CeremonialLocator @relation(fields: [locatorId], references: [id], onDelete: Restrict)

  @@unique([entityId, editionId])
  @@map("ceremonial_entity_variants")
}

model CeremonialMedia {
  id          String  @id @default(uuid()) @db.Uuid
  artifactId  String  @map("artifact_id") @db.Uuid
  entityId    String? @map("entity_id") @db.Uuid
  locatorId   String? @map("locator_id") @db.Uuid
  kind        String  @db.VarChar(30)
  rights      String  @default("UNKNOWN") @db.VarChar(30)
  access      String  @default("LOCAL_ONLY") @db.VarChar(20)
  sensitivity String  @default("CULTURALLY_SENSITIVE") @db.VarChar(30)

  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  artifact  CeremonialArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  entity    CeremonialEntity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)
  locator   CeremonialLocator? @relation(fields: [locatorId], references: [id], onDelete: SetNull)

  @@index([access, rights])
  @@map("ceremonial_media")
}

model CeremonialCorrespondence {
  id           String  @id @default(uuid()) @db.Uuid
  entityId     String  @map("entity_id") @db.Uuid
  editionId    String  @map("edition_id") @db.Uuid
  locatorId    String  @map("locator_id") @db.Uuid
  relationType String  @map("relation_type") @db.VarChar(40)
  targetKey    String  @map("target_key") @db.VarChar(120)
  note         String? @db.VarChar(1000)

  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  entity    CeremonialEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  edition   CeremonialEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  locator   CeremonialLocator @relation(fields: [locatorId], references: [id], onDelete: Restrict)

  @@unique([entityId, editionId, relationType, targetKey])
  @@index([relationType, targetKey])
  @@map("ceremonial_correspondences")
}

/// An explicit, sourced edge between two entities. Navigating a shared planet is allowed;
/// asserting identity is not, which is why the edge is typed and always has a locator.
model CeremonialCrossReference {
  id           String  @id @default(uuid()) @db.Uuid
  fromEntityId String  @map("from_entity_id") @db.Uuid
  toEntityId   String  @map("to_entity_id") @db.Uuid
  locatorId    String  @map("locator_id") @db.Uuid
  relationType String  @map("relation_type") @db.VarChar(40)
  note         String? @db.VarChar(1000)

  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  fromEntity CeremonialEntity  @relation("CeremonialCrossReferenceFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   CeremonialEntity  @relation("CeremonialCrossReferenceTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  locator    CeremonialLocator @relation(fields: [locatorId], references: [id], onDelete: Restrict)

  @@unique([fromEntityId, toEntityId, relationType])
  @@map("ceremonial_cross_references")
}

model CeremonialTimingProfile {
  id             String @id @default(uuid()) @db.Uuid
  sourceSystemId String @map("source_system_id") @db.Uuid
  editionId      String @map("edition_id") @db.Uuid
  locatorId      String @map("locator_id") @db.Uuid
  slug           String @db.VarChar(120)
  displayName    String @map("display_name") @db.VarChar(200)
  version        String @db.VarChar(60)
  rules          Json

  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceSystem CeremonialSourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: Restrict)
  edition      CeremonialEdition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  locator      CeremonialLocator      @relation(fields: [locatorId], references: [id], onDelete: Restrict)

  @@unique([slug, version])
  @@map("ceremonial_timing_profiles")
}

/// Structured approval. Rights review and editorial review are separate rows, so one
/// reviewer cannot satisfy both, and an expiry/revocation invalidates publication.
model CeremonialReview {
  id                String    @id @default(uuid()) @db.Uuid
  subjectType       String    @map("subject_type") @db.VarChar(30)
  subjectId         String    @map("subject_id") @db.Uuid
  reviewKind        String    @map("review_kind") @db.VarChar(20)
  decision          String    @db.VarChar(30)
  /// Facets this approval covers, e.g. ["metadata","quotation"].
  facetScope        Json      @map("facet_scope")
  reviewerId        String    @map("reviewer_id") @db.Uuid
  evidenceLocatorId String?   @map("evidence_locator_id") @db.Uuid
  decidedAt         DateTime  @default(now()) @map("decided_at") @db.Timestamptz(6)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  reviewer        CulturalContributor @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  evidenceLocator CeremonialLocator?  @relation(fields: [evidenceLocatorId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId, reviewKind])
  @@map("ceremonial_reviews")
}

/// Private practice planning. Every user-authored field is stored as an encrypted
/// envelope (Task 31); the columns below hold ciphertext, never plaintext.
model CeremonialPlan {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  birthProfileId    String? @map("birth_profile_id") @db.Uuid
  titleEnvelope     Json    @map("title_envelope")
  intentionEnvelope Json    @map("intention_envelope")
  selectionEnvelope Json?   @map("selection_envelope")
  scheduleEnvelope  Json?   @map("schedule_envelope")

  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfile BirthProfile?       @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  sessions     CeremonialSession[]

  @@index([userId, createdAt])
  @@map("ceremonial_plans")
}

model CeremonialSession {
  id                  String   @id @default(uuid()) @db.Uuid
  planId              String   @map("plan_id") @db.Uuid
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(6)
  notesEnvelope       Json?    @map("notes_envelope")
  observationEnvelope Json?    @map("observation_envelope")
  outcomeEnvelope     Json?    @map("outcome_envelope")

  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan      CeremonialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, occurredAt])
  @@map("ceremonial_sessions")
}
