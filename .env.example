# Copie para .env e substitua todos os valores marcados. Nunca versione .env.
POSTGRES_DB=astroaxe
POSTGRES_USER=astroaxe
POSTGRES_PASSWORD=replace-with-url-safe-random-value
REDIS_PASSWORD=replace-with-url-safe-random-value

DATABASE_URL=postgresql://astroaxe:replace-with-url-safe-random-value@postgres:5432/astroaxe?schema=public
REDIS_URL=redis://:replace-with-url-safe-random-value@redis:6379/0
GUEST_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_SECRET=replace-with-a-third-independent-32-character-secret
FINGERPRINT_SECRET=replace-with-a-different-32-character-secret
# Em Docker Swarm, omita os cinco valores acima e use os arquivos montados pelo serviço:
# DATABASE_URL_FILE=/run/secrets/astroaxe_database_url_v1
# REDIS_URL_FILE=/run/secrets/astroaxe_redis_url_v1
# GUEST_SESSION_SECRET_FILE=/run/secrets/astroaxe_guest_session_v1
# AUTH_SESSION_SECRET_FILE=/run/secrets/astroaxe_auth_session_v1
# FINGERPRINT_SECRET_FILE=/run/secrets/astroaxe_fingerprint_v1
NOMINATIM_USER_AGENT=AstroAxe/6.0 (contato@seu-dominio.example)

# Desenvolvimento e homologação local. Produção usa https://astroaxe.net (docs/cloudflare-edge.md).
SITE_URL=http://localhost
LOG_LEVEL=info

# Email transacional. Homologação usa Mailpit; produção usa relay autenticado (Brevo inicialmente).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=nao-responda@astroaxe.local
EMAIL_FROM_NAME=AstroAxe
# Produção: mantenha o usuário fora do Git e a senha em SMTP_PASSWORD_FILE no Swarm.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/astroaxe_smtp_password_v1

# Laboratório cerimonial. `disabled` (padrão) não expõe nenhuma superfície cerimonial.
# A stack pública (compose.yml) aceita apenas `disabled` ou `public`; escolher `local` ali
# falha na inicialização, porque compose.yml não declara acervo, keyring nem volume derivado.
CEREMONIAL_MODE=disabled

# Modo local: use exclusivamente compose.local.yml, que possui PostgreSQL, Redis, credenciais
# e volumes próprios, rede interna e publicação apenas em loopback. Nenhum valor abaixo pode
# ser copiado para a stack pública.
# CEREMONIAL_ARCHIVE_HOST_PATH=/mnt/e/Ocultismo
# CEREMONIAL_KEYRING_HOST_PATH=/caminho/local/fora-do-git/ceremonial-keyring.json
# CEREMONIAL_HTTP_PORT=3300
# CEREMONIAL_SITE_URL=http://127.0.0.1:3300
# CEREMONIAL_POSTGRES_DB=astroaxe_ceremonial
# CEREMONIAL_POSTGRES_USER=astroaxe_ceremonial
# CEREMONIAL_POSTGRES_PASSWORD=replace-with-an-independent-url-safe-random-value
# CEREMONIAL_REDIS_PASSWORD=replace-with-an-independent-url-safe-random-value
# CEREMONIAL_DATABASE_URL=postgresql://astroaxe_ceremonial:replace-with-an-independent-url-safe-random-value@ceremonial-postgres:5432/astroaxe_ceremonial?schema=public
# CEREMONIAL_REDIS_URL=redis://:replace-with-an-independent-url-safe-random-value@ceremonial-redis:6379/0
# CEREMONIAL_GUEST_SESSION_SECRET=replace-with-a-separate-32-character-secret
# CEREMONIAL_AUTH_SESSION_SECRET=replace-with-a-separate-32-character-secret
# CEREMONIAL_FINGERPRINT_SECRET=replace-with-a-separate-32-character-secret

# Ingest cerimonial (compose.ingest.yml): extração do acervo em container sem rede. Reaproveita
# CEREMONIAL_ARCHIVE_HOST_PATH acima e não precisa de banco, Redis nem segredo. O diretório de
# trabalho recebe manifestos e checkpoints e fica fora do repositório.
# CEREMONIAL_WORK_HOST_PATH=/caminho/local/fora-do-git/ceremonial-work
# CEREMONIAL_INGEST_CPUS=2.0
# CEREMONIAL_INGEST_MEMORY=3g

# Override opcional da observabilidade local. Prometheus publica somente em loopback.
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=1GB

# --- Cloudflare / borda de produção (docs/cloudflare-edge.md) ---
# IDs não são secretos e ficam registrados no runbook. Os tokens de Tunnel são secretos:
# preencha apenas no .env local e, em Swarm, entregue por `docker secret`, nunca por arquivo.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=astroaxe.net
CLOUDFLARE_TUNNEL_PROD_ID=
CLOUDFLARE_TUNNEL_STAGING_ID=
CLOUDFLARE_TUNNEL_PROD_TOKEN=
CLOUDFLARE_TUNNEL_STAGING_TOKEN=
CLOUDFLARE_HOLDING_WORKER=astroaxe-holding
CLOUDFLARE_HOLDING_ROUTE_ID=
