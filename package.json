{
  "name": "astroaxe",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Astrologia calculada, regencias culturais contextualizadas e ritual diario.",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check .",
    "gitignore:preview": "scripts/gitignore-preview.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "sonar": "sonar-scanner-npm"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "caelus": "0.24.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "ioredis": "6.0.0",
    "next": "16.3.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tz-lookup": "6.1.25",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sonar/scan": "5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/tz-lookup": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
